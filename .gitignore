# ------------------------------------------------------------
# Dependencies / Package managers
# ------------------------------------------------------------
node_modules/
.pnpm-store/
.npm/
.yarn/
.yarn-cache/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ------------------------------------------------------------
# Build outputs / caches
# ------------------------------------------------------------
dist/
build/
.next/
out/
.turbo/
.cache/
.eslintcache
*.tsbuildinfo

# Keep only required backend bundle artifact (your project-specific rule)
!apps/backend/dist/
apps/backend/dist/*
!apps/backend/dist/vercel.js

# ------------------------------------------------------------
# Runtime / temp / logs / pids
# ------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.seed
*.pid.lock
tmp/
temp/
*.tmp

# ------------------------------------------------------------
# Environment / secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# ------------------------------------------------------------
# IDE / editor
# ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.orig

# Cursor / local AI metadata
.cursor/
.agent/
.agents/
*.cursor-tmp

# ------------------------------------------------------------
