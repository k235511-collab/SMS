{
    "version": 2,
    "installCommand": "pnpm install --prefix=../..",
    "buildCommand": "pnpm --prefix=../.. --filter @sms-saas/backend build:vercel",
    "builds": [
        {
            "src": "api/index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/api/index.js"
        }
    ],
    "regions": [
        "sin1"
    ]
}