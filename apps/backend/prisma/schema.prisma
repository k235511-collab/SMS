  @@index([schoolId])
  @@map("grade_records")
}

model Book {
  id              String      @id @default(uuid())
  title           String
  author          String?
  isbn            String?
  category        String?
  publisher       String?
  edition         String?
  totalCopies     Int         @default(1)
  availableCopies Int         @default(1)
  location        String?
  coverImage      String?
  isActive        Boolean     @default(true)
  schoolId        String
