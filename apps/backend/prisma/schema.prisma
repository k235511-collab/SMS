  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([registrationNo, schoolId])
  @@index([schoolId])
  @@index([campusId])
  @@map("vehicles")
}

model TransportRoute {
  id                   String                @id @default(uuid())
  name                 String
  description          String?
  startLocation        String?
  endLocation          String?
  pickupTime           String?
  dropTime             String?
