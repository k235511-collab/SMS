generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model SubscriptionPlan {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  maxStudents Int?
  maxTeachers Int?
  maxCampuses Int?
  price       Float    @default(0)
  isActive    Boolean  @default(true)
  durationDays Int?    // Duration in days (null = lifetime)
  features    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  schools     School[]

  @@map("subscription_plans")
}

model PlatformAdmin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("platform_admins")
}

model School {
  id                   String                @id @default(uuid())
  name                 String
  slug                 String                @unique
  code                 String                @unique
  domain               String?               @unique
  logo                 String?
  address              String?
  phone                String?
  email                String?
  website              String?
  settings             Json?
  isActive             Boolean               @default(true)
  subscriptionPlanId   String?
  subscriptionExpiresAt DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  currentAcademicYearId String?
  currentAcademicYear  AcademicYear?         @relation("SchoolCurrentYear", fields: [currentAcademicYearId], references: [id])
  academicYears        AcademicYear[]        @relation("SchoolAcademicYears")
  assignments          Assignment[]
  attendances          Attendance[]
  auditLogs            AuditLog[]
  bookIssues           BookIssue[]
  books                Book[]
  calendarEvents       CalendarEvent[]
  campuses             Campus[]
  classes              Class[]
  communicationLogs    CommunicationLog[]
  examPapers           ExamPaper[]
  examQuestions        ExamQuestion[]
  examResults          ExamResult[]
  examSections         ExamSection[]
  examTeachers         ExamTeacher[]
  exams                Exam[]
  expenseCategories    ExpenseCategory[]
  expenses             Expense[]
  feePayments          FeePayment[]
  feeStructures        FeeStructure[]
  gradeRecords         GradeRecord[]
  gradingScales        GradingScale[]
  invoices             Invoice[]
  notifications        Notification[]
  parentStudents       ParentStudent[]
  periodTemplates      PeriodTemplate[]
  resources            Resource[]
  roles                Role[]
  subscriptionPlan     SubscriptionPlan?     @relation(fields: [subscriptionPlanId], references: [id])
  sections             Section[]
  studentDocuments     StudentDocument[]
  studentEnrollments   StudentEnrollment[]
  students             Student[]
  subjects             Subject[]
  submissions          Submission[]
  teachers             Teacher[]
  teacherClassAssignments TeacherClassAssignment[]
  timetableSlots       TimetableSlot[]
  transportAssignments TransportAssignment[]
  transportRoutes      TransportRoute[]
  users                User[]
  vehicles             Vehicle[]

  lastInvoiceNo       Int                   @default(0)
  @@index([subscriptionPlanId])
  @@index([currentAcademicYearId])
  @@map("schools")
}

model Campus {
  id                    String             @id @default(uuid())
  name                  String
  code                  String
  address               String?
  phone                 String?
  isActive              Boolean            @default(true)
  schoolId              String
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  books                 Book[]
  calendarEvents        CalendarEvent[]
  school                School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes               Class[]
  communicationLogs     CommunicationLog[]
  exams                 Exam[]
  expenses              Expense[]
  feeStructures         FeeStructure[]
  periodTemplates       PeriodTemplate[]
  resources             Resource[]
  students              Student[]
  teachers              Teacher[]
  transportRoutes       TransportRoute[]
  users                 User[]
  vehicles              Vehicle[]

  @@unique([code, schoolId])
  @@index([schoolId])
  @@map("campuses")
}

model User {
  id            String          @id @default(uuid())
  email         String
  passwordHash  String?
  googleId      String?
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  isActive      Boolean         @default(true)
  mustChangePassword Boolean    @default(false)
  lastLoginAt   DateTime?
  schoolId      String
  roleId        String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  address       String?
  bloodGroup    String?
  cnic          String?
  dateOfBirth   DateTime?
  gender        Gender?
  profession    String?
  qualification String?
  campusId      String?
  auditLogs     AuditLog[]
  children      ParentStudent[]
  student       Student?
  teacher       Teacher?
  campus        Campus?         @relation(fields: [campusId], references: [id])
  role          Role            @relation(fields: [roleId], references: [id])
  school        School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([email, schoolId])
  @@unique([googleId, schoolId])
  @@index([schoolId])
  @@index([roleId])
  @@index([campusId])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String
  slug        String
  description String?
  isSystem    Boolean          @default(false)
  schoolId    String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  campusId    String?
  permissions RolePermission[]
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  users       User[]
  defaultPermissions Json?

  @@unique([slug, schoolId, campusId])
  @@index([schoolId])
  @@index([campusId])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  slug            String           @unique
  module          String
  action          String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Class {
  id                 String              @id @default(uuid())
  name               String
  code               String
  sortOrder          Int                 @default(0)
  isActive           Boolean             @default(true)
  schoolId           String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  campusId           String
  assignments        Assignment[]
  teacherAssignments TeacherClassAssignment[]
  campus             Campus              @relation(fields: [campusId], references: [id])
  classTeachers      Teacher[]           @relation("ClassTeacher")
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exams              Exam[]
  feeStructures      FeeStructure[]
  sections           Section[]
  studentEnrollments StudentEnrollment[]
  students           Student[]
  subjects           Subject[]

  @@unique([code, campusId, schoolId])
  @@index([schoolId])
  @@index([campusId])
  @@map("classes")
}

model Section {
  id                 String              @id @default(uuid())
  name               String
  capacity           Int                 @default(40)
  isActive           Boolean             @default(true)
  classId            String
  schoolId           String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  attendances        Attendance[]
  teacherAssignments TeacherClassAssignment[]
  exams              Exam[]
  class              Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentEnrollments StudentEnrollment[]
  students           Student[]
  timetableSlots     TimetableSlot[]

  @@unique([name, classId])
  @@index([classId])
  @@index([schoolId])
  @@map("sections")
}

model Subject {
  id             String          @id @default(uuid())
  name           String
  code           String
  isActive       Boolean         @default(true)
  schoolId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  classId        String?
  assignments         Assignment[]
  examResults         ExamResult[]
  exams               Exam[]
  gradeRecords        GradeRecord[]
  teacherAssignments  TeacherClassAssignment[]
  class               Class?          @relation(fields: [classId], references: [id], onDelete: Cascade)
  school              School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableSlots      TimetableSlot[]

  @@unique([code, classId, schoolId])
  @@index([classId])
  @@index([schoolId])
  @@map("subjects")
}

model Student {
  id                   String                @id @default(uuid())
  rollNumber           String
  firstName            String
  lastName             String
  dateOfBirth          DateTime?
  gender               Gender?
  bloodGroup           String?
  guardianName         String?
  guardianPhone        String?
  guardianEmail        String?
  address              String?
  enrollmentDate       DateTime              @default(now())
  isActive             Boolean               @default(true)
  schoolId             String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  classId              String?
  sectionId            String?
  status               StudentStatus         @default(ACTIVE)
  deletedAt            DateTime?
  admissionNote        String?
  cnic                 String?
  group                String?
  phone                String?
  profileImage         String?
  religion             String?
  leaveDate            DateTime?
  leaveReason          String?
  userId               String?               @unique
  campusId             String
  attendances          Attendance[]
  bookIssues           BookIssue[]
  examResults          ExamResult[]
  feePayments          FeePayment[]
  gradeRecords         GradeRecord[]
  invoices             Invoice[]
  parents              ParentStudent[]
  documents            StudentDocument[]
  enrollments          StudentEnrollment[]
  campus               Campus                @relation(fields: [campusId], references: [id])
  class                Class?                @relation(fields: [classId], references: [id])
  school               School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section              Section?              @relation(fields: [sectionId], references: [id])
  user                 User?                 @relation(fields: [userId], references: [id])
  submissions          Submission[]
  transportAssignments TransportAssignment[]

  @@unique([rollNumber, campusId])
  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
  @@index([campusId])
  @@map("students")
}

model Teacher {
  id                  String          @id @default(uuid())
  employeeId          String
  firstName           String
  lastName            String
  qualification       String?
  specialization      String?
  joinDate            DateTime        @default(now())
  isActive            Boolean         @default(true)
  schoolId            String
  userId              String?         @unique
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  address             String?
  bloodGroup          String?
  cnic                String?
  dateOfBirth         DateTime?
  department          String?
  designation         String?
  experience          String?
  fatherHusbandCnic   String?
  fatherHusbandName   String?
  gender              Gender?
  maritalStatus       MaritalStatus?
  note                String?
  phone               String?
  photo               String?
  qualificationAtAppt String?
  religion            String?
  salary              Float?
  campusId            String
  classTeacherOfId    String?
  assignments         Assignment[]
  examTeachers        ExamTeacher[]
  classAssignments    TeacherClassAssignment[]
  campus              Campus          @relation(fields: [campusId], references: [id])
  classTeacherOf      Class?          @relation("ClassTeacher", fields: [classTeacherOfId], references: [id])
  school              School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user                User?           @relation(fields: [userId], references: [id])
  timetableSlots      TimetableSlot[]

  @@unique([employeeId, campusId])
  @@unique([classTeacherOfId, schoolId])
  @@index([schoolId])
  @@index([campusId])
  @@index([classTeacherOfId])
  @@map("teachers")
}

model Attendance {
  id        String           @id @default(uuid())
  date      DateTime         @db.Date
  status    AttendanceStatus
  remarks   String?
  studentId String
  sectionId String?
  schoolId  String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section   Section?         @relation(fields: [sectionId], references: [id])
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([schoolId])
  @@index([date])
  @@index([studentId])
  @@index([sectionId])
  @@map("attendances")
}

model Exam {
  id           String        @id @default(uuid())
  name         String
  type         ExamType
  startDate    DateTime?
  endDate      DateTime?
  totalMarks   Float         @default(100)
  passingMarks Float         @default(33)
  isActive     Boolean       @default(true)
  schoolId     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  campusId     String?
  classId      String
  duration     Float?
  sectionId    String
  status       ExamStatus    @default(DRAFT)
  subjectId    String
  academicYearId String?
  syllabus     String?
  weightage    Float?
  examPaper    ExamPaper?
  examResults  ExamResult[]
  examTeachers ExamTeacher[]
  campus       Campus?       @relation(fields: [campusId], references: [id])
  class        Class         @relation(fields: [classId], references: [id])
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section      Section       @relation(fields: [sectionId], references: [id])
  subject      Subject       @relation(fields: [subjectId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])

  @@index([schoolId])
  @@index([campusId])
  @@index([classId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([academicYearId])
  @@map("exams")
}

model ExamResult {
  id            String   @id @default(uuid())
  marksObtained Float
  grade         String?
  remarks       String?
  studentId     String
  examId        String
  subjectId     String
  schoolId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isAbsent      Boolean  @default(false)
  isPassed      Boolean?
  percentage    Float?
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, examId, subjectId])
  @@index([examId])
  @@index([subjectId])
  @@index([studentId])
  @@index([schoolId])
  @@map("exam_results")
}

model ExamTeacher {
  id        String   @id @default(uuid())
  examId    String
  teacherId String
  role      String   @default("INVIGILATOR")
  schoolId  String
  createdAt DateTime @default(now())
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([examId, teacherId])
  @@index([examId])
  @@index([teacherId])
  @@index([schoolId])
  @@map("exam_teachers")
}

model GradingScale {
  id         String   @id @default(uuid())
  name       String
  minPercent Float
  maxPercent Float
  gpa        Float?
  schoolId   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("grading_scales")
}

model FeeStructure {
  id          String       @id @default(uuid())
  name        String
  description String?
  amount      Float
  frequency   FeeFrequency
  dueDay      Int?
  isActive    Boolean      @default(true)
  schoolId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  classId     String?
  campusId    String
  campus      Campus       @relation(fields: [campusId], references: [id])
  class       Class?       @relation(fields: [classId], references: [id])
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoices    Invoice[]

  @@index([schoolId])
  @@index([classId])
  @@index([campusId])
  @@map("fee_structures")
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNo      String        @unique
  grossAmount    Float?
  discountType   DiscountType?
  discountValue  Float?
  discountAmount Float         @default(0)
  totalAmount    Float
  paidAmount     Float         @default(0)
  dueDate        DateTime
  status         InvoiceStatus @default(UNPAID)
  notes          String?
  schoolId       String
  studentId      String
  feeStructureId String?
  academicYearId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sequenceNo     Int?
  feePayments    FeePayment[]
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id])
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  @@unique([studentId, feeStructureId, academicYearId])
  @@index([schoolId])
  @@index([studentId])
  @@index([status])
  @@index([feeStructureId])
  @@index([academicYearId])
  @@map("invoices")
}

model FeePayment {
  id            String        @id @default(uuid())
  amount        Float
  method        PaymentMethod
  referenceNo   String?
  transactionId String?
  paidAt        DateTime      @default(now())
  notes         String?
  deletedAt     DateTime?
  invoiceId     String
  studentId     String
  schoolId      String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([studentId])
  @@index([schoolId])
  @@index([deletedAt])
  @@map("fee_payments")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  module     String
  entityType String
  entityId   String
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  schoolId   String
  userId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  campusId   String?
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([campusId])
  @@index([module])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AcademicYear {
  id                     String              @id @default(uuid())
  name                   String
  startDate              DateTime            @db.Date
  endDate                DateTime            @db.Date
  isCurrent              Boolean             @default(false)
  isActive               Boolean             @default(true)
  schoolId               String
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  school                 School              @relation("SchoolAcademicYears", fields: [schoolId], references: [id], onDelete: Cascade)
  schoolsUsingAsCurrent  School[]            @relation("SchoolCurrentYear")
  gradeRecords           GradeRecord[]
  enrollments            StudentEnrollment[]
  timetableSlots         TimetableSlot[]
  exams                  Exam[]
  teacherClassAssignments TeacherClassAssignment[]
  invoices               Invoice[]

  @@unique([name, schoolId])
  @@index([schoolId])
  @@map("academic_years")
}

model StudentEnrollment {
  id             String        @id @default(uuid())
  studentId      String
  academicYearId String
  classId        String
  sectionId      String?
  status         StudentStatus @default(ACTIVE)
  discountType   DiscountType?
  discountValue  Float?
  schoolId       String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class         @relation(fields: [classId], references: [id])
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section        Section?      @relation(fields: [sectionId], references: [id])
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([academicYearId])
  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
  @@map("student_enrollments")
}

model TimetableSlot {
  id             String        @id @default(uuid())
  dayOfWeek      Int
  startTime      String
  endTime        String
  room           String?
  sectionId      String
  subjectId      String
  teacherId      String?
  academicYearId String?
  schoolId       String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section        Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject        Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher        Teacher?      @relation(fields: [teacherId], references: [id])

  @@unique([sectionId, dayOfWeek, startTime])
  @@index([schoolId])
  @@index([teacherId])
  @@index([sectionId])
  @@map("timetable_slots")
}

model PeriodTemplate {
  id        String   @id @default(uuid())
  label     String
  startTime String
  endTime   String
  sortOrder Int      @default(0)
  isBreak   Boolean  @default(false)
  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  campusId  String?
  campus    Campus?  @relation(fields: [campusId], references: [id])
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, campusId, startTime])
  @@index([schoolId])
  @@index([campusId])
  @@map("period_templates")
}

model Notification {
  id          String           @id @default(uuid())
  title       String
  message     String
  type        NotificationType @default(INFO)
  isRead      Boolean          @default(false)
  link        String?
  recipientId String
  senderId    String?
  schoolId    String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead])
  @@index([schoolId])
  @@map("notifications")
}

model LoginHistory {
  id        String   @id @default(uuid())
  email     String
  success   Boolean
  userType  String
  userId    String?
  schoolId  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([userId])
  @@index([schoolId])
  @@index([createdAt])
  @@map("login_history")
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("platform_settings")
}

model Assignment {
  id          String         @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime
  totalMarks  Float          @default(100)
  type        AssignmentType @default(HOMEWORK)
  isActive    Boolean        @default(true)
  classId     String
  subjectId   String
  teacherId   String?
  schoolId    String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  class       Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     Teacher?       @relation(fields: [teacherId], references: [id])
  submissions Submission[]

  @@index([schoolId])
  @@index([classId])
  @@index([teacherId])
  @@map("assignments")
}

model Submission {
  id           String           @id @default(uuid())
  content      String?
  fileUrl      String?
  marks        Float?
  grade        String?
  feedback     String?
  status       SubmissionStatus @default(PENDING)
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?
  studentId    String
  assignmentId String
  schoolId     String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
