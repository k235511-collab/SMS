// ═══════════════════════════════════════════════════════════════
// EXAM PAPER BUILDER
// ═══════════════════════════════════════════════════════════════

model ExamPaper {
  id            String        @id @default(uuid())
  examId        String        @unique
  schoolId      String
  paperTitle         String        @default("")
  schoolName        String        @default("")
  schoolLogo        String        @default("")
  headerInstructions String       @default("")
  date              String        @default("")
  totalMarks        Int           @default(100)
  duration          String        @default("2 hours")
  instructions      String        @default("")
  version       Int           @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  exam     Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  school   School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections ExamSection[]

  @@index([schoolId])
  @@map("exam_papers")
}

model ExamSection {
  id           String         @id @default(uuid())
  paperId      String
  schoolId     String
  title        String         @default("")
  type         SectionType    @default(SUBJECTIVE)
  instructions String         @default("")
  totalMarks   Int            @default(0)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  paper     ExamPaper      @relation(fields: [paperId], references: [id], onDelete: Cascade)
  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  questions ExamQuestion[]

  @@index([paperId])
  @@index([schoolId])
  @@map("exam_sections")
}

model ExamQuestion {
  id             String         @id @default(uuid())
  sectionId      String
  schoolId       String
  questionText   String         @default("")
  questionType   QuestionType   @default(SHORT_ANSWER)
  marks          Float          @default(1)
  sortOrder      Int            @default(0)
  imageBase64    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  section  ExamSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  school   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  options  QuestionOption[]

  @@index([sectionId])
  @@index([schoolId])
  @@map("exam_questions")
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  optionText String   @default("")
  isCorrect  Boolean  @default(false)
  sortOrder  Int      @default(0)

  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@index([questionId])
  @@map("question_options")
}

enum SectionType {
  OBJECTIVE
  SUBJECTIVE
  FILL_BLANK
  TRUE_FALSE
  MATCHING
  CUSTOM
}

enum QuestionType {
  MCQ
  SHORT_ANSWER
  LONG_ANSWER
  FILL_BLANK
  TRUE_FALSE
  MATCHING
}

// ═══════════════════════════════════════════════════════════════
// School Registration Requests (self-service signup + approval)
// ═══════════════════════════════════════════════════════════════

model SchoolRegistration {
  id                String             @id @default(uuid())
  schoolName        String
  slug              String             @unique
  code              String             @unique
  email             String?
  phone             String?
  address           String?
  domain            String?
  website           String?

  // Admin credentials (stored until approval)
  adminEmail        String
  adminFirstName    String
  adminLastName     String
  adminGoogleId     String?
  adminPasswordHash String?

  // Approval workflow
  status            RegistrationStatus @default(PENDING)
  rejectionReason   String?
  reviewedAt        DateTime?
  reviewedBy        String?

  // Resulting school (set after approval)
  schoolId          String?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status])
  @@index([adminEmail])
  @@map("school_registrations")
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}
