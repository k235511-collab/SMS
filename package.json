{
  "name": "sms-saas",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "quality": "node -e \"const { execSync } = require('node:child_process'); ['pnpm quality:shared-types','pnpm quality:frontend','pnpm quality:backend:test','pnpm quality:backend:build'].forEach((command) => execSync(command, { stdio: 'inherit' }));\"",
    "quality:shared-types": "pnpm --filter @sms-saas/shared-types lint",
    "quality:frontend": "pnpm --filter @sms-saas/frontend lint",
    "quality:backend:test": "pnpm --filter @sms-saas/backend exec jest --runInBand",
    "quality:backend:build": "pnpm --filter @sms-saas/backend build:vercel",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "description": "A monorepo-based, multi-tenant School Management SaaS built with Next.js 15, React 19, NestJS, Prisma, and TypeScript.",
  "main": "fix-file.js",
  "dependencies": {
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.1.7",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-module-utils": "^2.12.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-scope": "^8.4.0",
    "eslint-visitor-keys": "^4.2.1",
    "xlsx": "^0.18.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k235511-collab/SMS.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/k235511-collab/SMS/issues"
  },
  "homepage": "https://github.com/k235511-collab/SMS#readme"
}
